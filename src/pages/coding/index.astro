---
import { getCollection } from "astro:content";

import Base from "../../layouts/Base.astro";

const TOTAL = 150;

const problems = (await getCollection("problems"))
  .filter((problem) => !problem.data.draft)
  .sort((a, b) => a.data.order - b.data.order);

const categories: { name: string; items: typeof problems }[] = [];

for (const problem of problems) {
  const last = categories[categories.length - 1];

  if (last && last.name === problem.data.category) {
    last.items.push(problem);
  } else {
    categories.push({ name: problem.data.category, items: [problem] });
  }
}

const MARK = { solo: "✓", hint: "△", fail: "✗" } as const;
const LABEL = { solo: "solved", hint: "with a hint", fail: "not solved" } as const;

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    timeZone: "UTC",
  });
---

<Base
  title="Coding"
  description="NeetCode 150 — my solutions and the one idea that cracks each problem."
>
  <header class="page-header">
    <h1>Coding</h1>

    <p class="page-description">
      Working through NeetCode 150. For each problem: the pattern, the one idea
      that cracks it, and my own solution.
    </p>

    <p class="progress-label">
      {problems.length} / {TOTAL} solved · ✓ on my own · △ with a hint · ✗ not yet
    </p>
  </header>

  {
    categories.map((category) => (
      <section class="problem-group">
        <h2>
          {category.name}
          <span>{category.items.length}</span>
        </h2>

        <div class="problem-list">
          {category.items.map((problem) => (
            <a class="problem-item" href={`/coding/${problem.id}/`}>
              <span class="problem-main">
                <span class="problem-title">{problem.data.title}</span>
                {problem.data.pattern && (
                  <span class="problem-idea">
                    {problem.data.pattern}
                    {problem.data.idea && ` — ${problem.data.idea}`}
                  </span>
                )}
              </span>

              <span class="problem-meta">
                <span class={`difficulty ${problem.data.difficulty.toLowerCase()}`}>
                  {problem.data.difficulty}
                </span>
                <span class="attempt-marks">
                  {problem.data.attempts.map((attempt) => (
                    <span
                      class={attempt.result}
                      title={`${formatDate(attempt.date)}: ${LABEL[attempt.result]}`}
                    >
                      {MARK[attempt.result]}
                    </span>
                  ))}
                </span>
              </span>
            </a>
          ))}
        </div>
      </section>
    ))
  }

  {
    problems.length === 0 && (
      <p class="page-description">Nothing here yet — the first problems are on their way.</p>
    )
  }
</Base>
